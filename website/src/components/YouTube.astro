---
/**
 * A YouTube video in a 16:9 frame as wide as its column. It plays from youtube-nocookie.com
 * (YouTube's privacy-enhanced mode: no cookies until the visitor plays the video) and the player
 * loads only when it nears the screen. With an empty `id` the frame says the video is coming soon.
 */
interface Props {
  id: string
  title: string
  /** The note shown while there is no video yet. */
  soon?: string
}
const { id, title, soon = 'Video coming soon.' } = Astro.props
if (id !== '' && !/^[\w-]{11}$/.test(id)) throw new Error(`Not a YouTube video ID: "${id}"`)
---

{
  id ? (
    <div class="youtube not-content">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${id}`}
        title={title}
        loading="lazy"
        allow="encrypted-media; picture-in-picture; fullscreen"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
      />
    </div>
  ) : (
    <div class="youtube youtube-soon not-content">
      <p>{soon}</p>
    </div>
  )
}

<style>
  .youtube {
    max-width: 56rem;
    margin: 1.5rem auto;
    aspect-ratio: 16 / 9;
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--sl-color-black);
  }
  .youtube iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  /* A short box, not an empty 16:9 frame. */
  .youtube-soon {
    aspect-ratio: auto;
    padding: 2rem 1rem;
    text-align: center;
    display: grid;
    place-items: center;
    border: 1px dashed var(--sl-color-gray-4);
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
  }
  .youtube-soon p {
    margin: 0;
  }
</style>
