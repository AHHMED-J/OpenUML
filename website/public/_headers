# Security headers, applied by Cloudflare when it serves the site (static files: no server code).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Only openuml.org is indexed: the workers.dev addresses (production and branch previews) say
# noindex. A host placeholder never matches a dot, so this pattern covers <name>.<account>.workers.dev.
https://:name.:account.workers.dev/*
  X-Robots-Tag: noindex

# The app: the same policy as its page, plus frame-ancestors (a <meta> policy cannot set it).
# Nothing is fetched from other sites: models never leave the computer.
/app/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'; worker-src 'none'; manifest-src 'none'; media-src 'none'

# The page itself is checked on every visit, so a new version reaches everyone at once.
/app/
  Cache-Control: no-cache
/app/index.html
  Cache-Control: no-cache

# File names carry a content hash: they never change.
/app/assets/*
  Cache-Control: public, max-age=31536000, immutable
