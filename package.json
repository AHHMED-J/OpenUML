{
  "name": "openuml",
  "productName": "OpenUML",
  "version": "0.1.8",
  "description": "Open-source UML modeling tool (class, use case, sequence and activity diagrams) with .mdj file compatibility.",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "desktopName": "openuml.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint:unused": "npx -y knip@6.41.0 --no-progress",
    "dist": "electron-vite build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "happy-dom": "20.14.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "zustand": "5.0.15"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "io.github.ahhmed-j.openuml",
    "productName": "OpenUML",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "asarUnpack": [
      "resources/**"
    ],
    "fileAssociations": [
      {
        "ext": "mdj",
        "name": "OpenUML Model",
        "description": "OpenUML model",
        "mimeType": "application/x-openuml-model",
        "role": "Editor",
        "icon": "document"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Development",
      "target": [
        "AppImage"
      ],
      "syncDesktopName": true
    }
  }
}
